# AnvilMCP Security Policy Configuration
# Controls what operations are allowed on this container.
# Place a user copy at ~/.config/anvilmcp/config.yaml to override defaults.

version: 1

# Session-level defaults
session:
  cwd: /workspace

# Filesystem access control
paths:
  workspace_root: /workspace

  # Paths that can be read (supports ** for recursive globs)
  allow_read:
    - /workspace/**
    - /usr/local/lib/python3/**  # Allow reading Python libraries

  # Paths that can be written/created (supports ** for recursive globs)
  allow_write:
    - /workspace/**

  # Paths that are always blocked regardless of allow lists
  deny:
    - /workspace/.git/**
    - /home/**/.ssh/**
    - /home/**/.aws/**
    - /home/**/.gnupg/**
    - /run/secrets/**
    - /etc/**
    - "**/.env"
    - "**/anvilmcp/config.yaml"

# Command execution control
exec:
  # Default: "allow" or "deny"
  default: deny

  # Allowed commands with optional argument restrictions
  allow:
    python3:
      subcommands: []
      args_deny: []
    pytest:
      subcommands: []
      args_deny: []
    ls:
      subcommands: []
      args_deny: []
    cat:
      subcommands: []
      args_deny: []
    git:
      subcommands: []
      args_deny:
        - push
        - reset
        - clean
        - checkout
    pip:
      subcommands: []
      args_deny:
        - uninstall
        - "--break-system-packages"

  # Explicitly denied commands (always blocks)
  deny:
    - rm
    - dd
    - mkfs*
    - ssh
    - scp

  # Commands that require confirmation (optional, Phase 2)
  ask: {}

  # Execution limits
  shell_interpolation: false      # Disable shell variable expansion
  max_runtime_seconds: 300        # 5 minute timeout
  max_output_bytes: 5000000       # 5 MB output limit
  max_concurrent: 4               # Max parallel executions

# Environment variable control
env:
  # Regex patterns for variable names to redact (not expose to tools)
  redact_patterns:
    - '(?i)secret'
    - '(?i)token'
    - '(?i)password'
    - '(?i)api[_-]?key'
    - '(?i)credential'

  # Explicitly denied variables
  explicit_deny: []

  # If non-empty, whitelist mode (only these are allowed)
  allow_only: []

# Audit and history control
# Every tool and resource invocation is recorded here: the call, its arguments
# (secret-looking keys redacted per env.redact_patterns), the policy decision,
# and the outcome. This is the control that still holds when the others are
# stepped around -- an allow-listed interpreter can reach anything the
# container can, so the trail is how you find out that it did.
audit:
  history_db_path: ~/.local/state/anvilmcp/history.db
  retention_days: 30
  max_total_bytes: 1073741824  # 1 GB; oldest rows dropped first once exceeded

  # Append completed records as JSON Lines, for a log shipper to tail.
  # Unset disables the mirror; the database is written either way.
  jsonl_mirror_path: ""

  # Refuse a tool call when its audit record cannot be written. Off by default
  # so a full or read-only state volume degrades the trail rather than the
  # session. Turn it on where "no record" must mean "did not happen".
  fail_closed: false

  # Tools whose stdout/stderr previews are not stored (the call still is)
  no_store_output: []

  # Tools not recorded at all. Leaving this empty is the secure default;
  # anything listed here executes with no durable record.
  no_store_tools: []
